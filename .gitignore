# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env：預設值檔（.env.development、.env.production）進 git；機密與個人設定不進
/.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cowork 的考卷資料：只追蹤 meta（.json／.jsonl／.md），考卷檔不進 git
/output/**
!/output/**/
!/output/**/*.json
!/output/**/*.jsonl
!/output/**/*.md

# npm run catalog 從 output/ 產生
/data/pastExams.json
/data/pastExams.json.tmp

# npm run pdfjs-assets 從 node_modules/pdfjs-dist 複製
/public/pdfjs/

# playwright
.playwright-mcp/