{
  "name": "tw-exams",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 6789",
    "build": "next build",
    "start": "next start -p 6789",
    "lint": "eslint",
    "test": "vitest run",
    "catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-exam-catalog.ts",
    "predev": "npm run catalog && npm run pdfjs-assets",
    "prebuild": "npm run catalog && npm run pdfjs-assets",
    "icons": "node scripts/generate-icons.mjs && node scripts/generate-og-image.mjs",
    "upload:exams": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/upload-exams.ts",
    "pdfjs-assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/copy-pdfjs-assets.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "daisyui": "^5.7.46",
    "lucide-react": "^0.575.0",
    "next": "16.3.6",
    "pdfjs-dist": "^5.4.296",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
